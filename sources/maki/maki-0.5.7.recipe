SOURCE_URI_687="https://github.com/tontinton/syntect/archive/01df275f6f25da670e5ba5b7128cb89d03795119.tar.gz"
CHECKSUM_SHA256_687="ee96b75c2e3c53d8e7593960aa60148c89551b99ac52e01576f8a03d57f824e9"
SOURCE_FILENAME_687="syntect-01df275f6f25da670e5ba5b7128cb89d03795119.tar.gz"

ARCHITECTURES="!x86_gcc2 x86_64"

PROVIDES="
	maki = $portVersion
	cmd:maki = $portVersion
	"
REQUIRES="
	haiku
	lib:libcrypto >= 3
	lib:libcurl
	lib:libssl >= 3
	lib:libz
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libcrypto >= 3
	devel:libcurl
	devel:libssl >= 3
	devel:libz
	"
BUILD_PREREQUIRES="
	cmd:cargo
	cmd:gcc
	cmd:pkg_config
	cmd:rustc >= 1.95
	"

defineDebugInfoPackage maki \
	"$prefix"/bin/maki

BUILD()
{
	# cargo prepends its own directories to LIBRARY_PATH for the rustc it
	# spawns; if LIBRARY_PATH is empty (as in the build chroot) the system
	# library paths are lost and rustc cannot load libroot (exit status 3).
	export LIBRARY_PATH="%A/lib:/boot/system/lib"
	export CARGO_HOME=$sourceDir/../cargo
	vendor=$CARGO_HOME/haiku
	vendorGit=$CARGO_HOME/haiku-git
	mkdir -p "$vendor" "$vendorGit"

	# crates.io crates
	for i in $(seq 2 685); do
		eval "srcDir=\$sourceDir$i"
		eval "sha256sum=\$CHECKSUM_SHA256_$i"
		set -- "$srcDir"/*
		ln -sf "$1" "$vendor"
		cat <<-EOF >"$vendor/${1##*/}/.cargo-checksum.json"
		{
		  "package": "$sha256sum",
		  "files": {}
		}
		EOF
	done

	# git dependencies (crossterm, syntect): their manifests do not inherit
	# from a workspace, so they can be served as a directory source
	for i in $(seq 686 687); do
		eval "srcDir=\$sourceDir$i"
		set -- "$srcDir"/*
		ln -sf "$1" "$vendorGit"
		echo '{"package":null,"files":{}}' >"$vendorGit/${1##*/}/.cargo-checksum.json"
	done

	cat <<-EOF >"$CARGO_HOME"/config.toml
	[source.haiku]
	directory = "$vendor"

	[source.haiku-git]
	directory = "$vendorGit"

	[source.crates-io]
	replace-with = "haiku"

	[source."git+https://github.com/crossterm-rs/crossterm?rev=3ca54292d2b1f1c58e200a06122ddaf5dd6b5c77"]
	git = "https://github.com/crossterm-rs/crossterm"
	rev = "3ca54292d2b1f1c58e200a06122ddaf5dd6b5c77"
	replace-with = "haiku-git"

	[source."git+https://github.com/tontinton/syntect?rev=01df275f6f25da670e5ba5b7128cb89d03795119"]
	git = "https://github.com/tontinton/syntect"
	rev = "01df275f6f25da670e5ba5b7128cb89d03795119"
	replace-with = "haiku-git"
	EOF

	cargo build --release --frozen
}

INSTALL()
{
	install -v -m 755 -d "$prefix"/bin "$docDir"
	install -v -m 755 target/release/maki "$prefix"/bin
	install -v -m 644 README.md "$docDir"
}

TEST()
{
	export LIBRARY_PATH="%A/lib:/boot/system/lib"
	export CARGO_HOME=$sourceDir/../cargo
	cargo test --release --frozen
}
