resource app_signature "application/x-vnd.storytold-pdfcraft-haiku";
resource app_flags B_MULTIPLE_LAUNCH;
resource app_version {
    major = 0,
    middle = 8,
    minor = 0,
    variety = B_APPV_ALPHA,
    internal = 1,
    short_info = "Pdfcraft 0.8.0 (Haiku experimental)",
    long_info = "PDF editor with an experimental Haiku software frontend"
};
