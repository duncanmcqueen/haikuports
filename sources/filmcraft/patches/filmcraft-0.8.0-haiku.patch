+
+use easy_parallel::Parallel;
+use polling::Events;
+use polling::Poller;
+
+#[test]
+fn simple() -> io::Result<()> {
+    let poller = Poller::new()?;
+    let mut events = Events::new();
+
+    for _ in 0..10 {
+        poller.notify()?;
+        poller.wait(&mut events, None)?;
