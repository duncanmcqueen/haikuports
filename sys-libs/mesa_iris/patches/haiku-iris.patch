+// HGL hardware color buffers are linear. Wait for the producing fence in
+// SwapBuffers, then map the original resource without a staging GPU blit.
+static bool
+haiku_present_readback(struct haiku_egl_surface *hgl_surf, struct st_context *st,
+                       struct pipe_resource *backBuffer)
+{
+   BitmapHook *hook = (BitmapHook *)hgl_surf->fb->winsysContext;
+   if (hook == NULL || backBuffer == NULL)
+      return true;
+
+   // Use the rendered resource's dimensions. A window resize can precede
+   // attachment revalidation; mapping the new window size would overrun it.
+   const uint32_t width = backBuffer->width0;
+   const uint32_t height = backBuffer->height0;
+   if (width == 0 || height == 0)
+      return true;
+   if (backBuffer->format != PIPE_FORMAT_B8G8R8X8_UNORM &&
+       backBuffer->format != PIPE_FORMAT_B8G8R8A8_UNORM)
+      return false;
+
+   BBitmap *&bitmap = hgl_surf->present_spare;
+   BRect bounds(0, 0, width - 1, height - 1);
+   if (bitmap != NULL && bitmap->Bounds() != bounds) {
+      delete bitmap;
+      bitmap = NULL;
+   }
+   if (bitmap == NULL)
+      bitmap = new(std::nothrow) BBitmap(bounds, B_RGB32);
+   if (bitmap == NULL || bitmap->InitCheck() != B_OK || bitmap->Bits() == NULL)
+      return false;
+
+   bigtime_t start = system_time();
+   struct pipe_context *pipe = st->pipe;
+   struct pipe_box box = {};
+   box.width = width;
+   box.height = height;
+   box.depth = 1;
+   struct pipe_transfer *pt = NULL;
+   const uint8_t *src = (const uint8_t *)pipe->texture_map(pipe, backBuffer,
+      0, PIPE_MAP_READ | PIPE_MAP_DIRECTLY, &box, &pt);
+   if (src == NULL) {
+      ERROR("present: direct texture map failed\n");
+      return false;
+   }
+   hgl_surf->present_map_us += system_time() - start;
+   start = system_time();
+   uint8_t *dst = (uint8_t *)bitmap->Bits();
+   const size_t row_bytes = (size_t)width * 4;
+   const uint32_t dst_stride = bitmap->BytesPerRow();
+   if (pt->stride < row_bytes || dst_stride < row_bytes) {
+      pipe->texture_unmap(pipe, pt);
+      return false;
+   }
+   for (uint32_t y = 0; y < height; ++y)
+      memcpy(dst + (size_t)y * dst_stride, src + (size_t)y * pt->stride,
+             row_bytes);
+   hgl_surf->present_copy_us += system_time() - start;
+
+   ++hgl_surf->present_frames;
+   if (hgl_surf->present_frames == 30) {
+      haiku_dump_ppm(getenv("EGL_HAIKU_DUMP"), src, pt->stride, width, height);
+      haiku_dump_ppm(getenv("EGL_HAIKU_DUMP_BMP"), dst, dst_stride, width, height);
+   }
+   pipe->texture_unmap(pipe, pt);
+
+   start = system_time();
+   bitmap = hook->SetBitmap(bitmap);
+   hgl_surf->present_hook_us += system_time() - start;
+   if (getenv("EGL_HAIKU_PROFILE") != NULL && hgl_surf->present_frames % 120 == 0) {
+      double frames = hgl_surf->present_frames;
+      printf("present avg us: flush=%.1f wait=%.1f map=%.1f copy=%.1f hook=%.1f frames=%u\n",
+         hgl_surf->present_flush_us / frames, hgl_surf->present_wait_us / frames,
+         hgl_surf->present_map_us / frames, hgl_surf->present_copy_us / frames,
+         hgl_surf->present_hook_us / frames, hgl_surf->present_frames);
+   }
+   return true;
+}
