+calloop013 = { package = "calloop", git = "https://github.com/duncanmcqueen/calloop", rev = "80641145888ac2eb97586ea688279527d014c8a2" }
+calloop014 = { package = "calloop", git = "https://github.com/duncanmcqueen/calloop", rev = "bcad6118cdc3e20dd5ee10db890291fa19a38b42" }
+sctk019 = { package = "smithay-client-toolkit", git = "https://github.com/duncanmcqueen/client-toolkit", rev = "825cbd720e047ff6358e8c3a940763cd58721e73" }
