+
+hayro-interpret = { path = "../../vendor/hayro-interpret" }
+hayro = { path = "../../vendor/hayro" }
+hayro-syntax = { path = "../../vendor/hayro-syntax" }
+hayro-jbig2 = { path = "../../vendor/hayro-jbig2" }
+lopdf = { path = "../../vendor/lopdf" }
+egui-wgpu = { path = "../../vendor/egui-wgpu" }
+
+[lints.rust]
+unsafe_code = "forbid"
+
+[lints.clippy]
+unwrap_used = "deny"
+expect_used = "deny"
+panic = "deny"
+unimplemented = "deny"
+todo = "deny"
