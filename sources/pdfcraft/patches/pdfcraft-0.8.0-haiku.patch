+[package]
+name = "pdfcraft-haiku"
+version = "0.8.0"
+edition = "2024"
+license = "MIT OR Apache-2.0"
+publish = false
+
+[workspace]
+resolver = "3"
+
+[[bin]]
+name = "pdfcraft-haiku"
+path = "src/main.rs"
+
+[[bin]]
+name = "pdfcraft-cli"
+path = "../pdfcraft-cli/src/main.rs"
+
+[features]
+default = []
+mcp = ["pdfcraft-automation/mcp"]
+
+[dependencies]
+pdfcraft-ui-egui = { path = "../../crates/ui-egui" }
+pdfcraft-engine = { path = "../../crates/engine" }
+pdfcraft-render = { path = "../../crates/render" }
+pdfcraft-audit = { path = "../../crates/audit" }
+pdfcraft-cos = { path = "../../crates/cos" }
+pdfcraft-automation = { path = "../../crates/automation", default-features = false }
+egui = "0.36"
+serde_json = "1"
+base64 = "0.22"
+rustix = { version = "1", features = ["process"] }
+egui_software_backend = { git = "https://github.com/duncanmcqueen/egui_software_backend", rev = "451c0bab15486c3e23167df993826b83e31ddc79", features = ["rayon"] }
+
+[patch.crates-io]
+polling = { path = "../../port-crates/polling" }
