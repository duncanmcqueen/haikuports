From 979a67b8e075280ab195b3157dde704dac8f9957 Mon Sep 17 00:00:00 2001
From: Duncan McQueen <dwmcqueen@gmail.com>
Date: Thu, 8 Oct 2026 12:46:45 -0500
Subject: [PATCH 1/2] Haiku: adjust sources for maki 0.6.0

Drop arboard's wayland-data-control feature on Haiku (wayland-backend
does not build); clipboard falls back to OSC 52. Stub system_uses_12h to
false on Haiku because the libc crate binds neither newlocale nor
nl_langinfo_l/T_FMT there. Read terminal input through crossterm's
use-dev-tty backend: mio's poll backend stops reporting the tty readable
after the first key event. Use crates.io monty 0.0.23 instead of the git
tag so it can be vendored offline, and link the system libcurl/OpenSSL by
replacing isahc's static-curl and native-tls-static features with the
dynamic native-tls feature (the bundled curl >= 8.20 hangs on Haiku
before the first request completes).
---
 Cargo.toml           |  6 +++---
 maki-ui/Cargo.toml   | 10 +++++++++-
 maki-ui/src/clock.rs |  8 +++++++-
 3 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index dd91741..7176fb0 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -144,7 +144,7 @@ async-io = "2"
 event-listener = "5"
 futures-lite = "2"
 futures = "0.3"
-isahc = { version = "2.0", default-features = false, features = ["text-decoding", "static-curl", "native-tls-static", "http2"] }
+isahc = { version = "2.0", default-features = false, features = ["text-decoding", "native-tls", "http2"] }
 flate2 = "1"
 libc = "0.2"
 windows-sys = { version = "0.61", features = ["Win32_Globalization"] }
@@ -191,8 +191,8 @@ tree-sitter-css = "0.25"
 tree-sitter-hcl = "1.1"
 tree-sitter-json = "0.24"
 tree-sitter-make = "1.1"
-monty = { git = "https://github.com/pydantic/monty.git", tag = "v0.0.23", package = "monty" }
-monty-types = { git = "https://github.com/pydantic/monty.git", tag = "v0.0.23", package = "monty-types" }
+monty = "=0.0.23"
+monty-types = "=0.0.23"
 notify = { version = "9.0.0-rc.5", default-features = false, features = ["flume", "macos_fsevent"] }
 serde_yaml = "0.9"
 shell-words = "1"
diff --git a/maki-ui/Cargo.toml b/maki-ui/Cargo.toml
index 53d2659..1966038 100644
--- a/maki-ui/Cargo.toml
+++ b/maki-ui/Cargo.toml
@@ -21,7 +21,6 @@ syntect = { workspace = true }
 unicode-width = { workspace = true }
 unicode-segmentation = { workspace = true }
 serde_json = { workspace = true }
-arboard = { workspace = true }
 jiff = { workspace = true }
 smol = { workspace = true }
 flume = { workspace = true }
@@ -46,6 +45,15 @@ shell-words = { workspace = true }
 open = { workspace = true }
 
 
+[target.'cfg(not(target_os = "haiku"))'.dependencies]
+arboard = { workspace = true }
+
+[target.'cfg(target_os = "haiku")'.dependencies]
+arboard = { version = "3", default-features = false, features = ["image-data"] }
+# mio's poll backend stops delivering tty input on Haiku after the first event;
+# read the terminal through plain poll() on /dev/tty instead.
+crossterm = { workspace = true, features = ["use-dev-tty"] }
+
 [target.'cfg(windows)'.dependencies]
 windows-sys = { workspace = true }
 
diff --git a/maki-ui/src/clock.rs b/maki-ui/src/clock.rs
index 1e9fc30..19c7d4b 100644
--- a/maki-ui/src/clock.rs
+++ b/maki-ui/src/clock.rs
@@ -31,7 +31,7 @@ fn posix_fmt_is_12h(fmt: &[u8]) -> bool {
         .any(|w| matches!(w, b"%I" | b"%l" | b"%p" | b"%r"))
 }
 
-#[cfg(unix)]
+#[cfg(all(unix, not(target_os = "haiku")))]
 fn system_uses_12h() -> bool {
     use std::ffi::CStr;
     // The libc crate does not bind `nl_langinfo_l` on Apple targets,
@@ -54,6 +54,12 @@ fn system_uses_12h() -> bool {
     }
 }
 
+// Haiku: the libc crate lacks newlocale/nl_langinfo_l/T_FMT bindings; default to 24h.
+#[cfg(target_os = "haiku")]
+fn system_uses_12h() -> bool {
+    false
+}
+
 #[cfg(windows)]
 fn system_uses_12h() -> bool {
     use windows_sys::Win32::Globalization::{GetLocaleInfoEx, LOCALE_STIMEFORMAT};
-- 
2.56.0

From 3f6231c24206cc1cb8b491bda501e9788bec9cfd Mon Sep 17 00:00:00 2001
From: Duncan McQueen <dwmcqueen@gmail.com>
Date: Thu, 8 Oct 2026 12:46:45 -0500
Subject: [PATCH 2/2] Haiku: update Cargo.lock for maki 0.6.0

monty/monty-macros/monty-types now come from crates.io, the isahc static
TLS build (openssl-src) is dropped in favor of system OpenSSL via
openssl-sys, and crossterm's use-dev-tty backend adds filedescriptor.
---
 Cargo.lock | 20 +++++++-------------
 1 file changed, 7 insertions(+), 13 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 96b8aa7..884354b 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1036,6 +1036,7 @@ dependencies = [
  "bitflags 2.13.2",
  "crossterm_winapi",
  "derive_more",
+ "filedescriptor",
  "mio",
  "parking_lot",
  "rustix 1.1.5",
@@ -3415,7 +3416,8 @@ dependencies = [
 [[package]]
 name = "monty"
 version = "0.0.23"
-source = "git+https://github.com/pydantic/monty.git?tag=v0.0.23#302e0f27ec8516689ba90793cd0381149e5f4076"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "e027c3c5863ee7b2f2ad8d30c64dafa7adaa3037f90607729753d4e0ead066de"
 dependencies = [
  "ahash",
  "chrono",
@@ -3452,7 +3454,8 @@ dependencies = [
 [[package]]
 name = "monty-macros"
 version = "0.0.23"
-source = "git+https://github.com/pydantic/monty.git?tag=v0.0.23#302e0f27ec8516689ba90793cd0381149e5f4076"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "28e9bdf290033997d894fa5da829e033ecd1d6d9f57c981b631a440a9a3a0d02"
 dependencies = [
  "proc-macro2",
  "quote",
@@ -3462,7 +3465,8 @@ dependencies = [
 [[package]]
 name = "monty-types"
 version = "0.0.23"
-source = "git+https://github.com/pydantic/monty.git?tag=v0.0.23#302e0f27ec8516689ba90793cd0381149e5f4076"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "64c1da1edc680115e1f8cd898a99c01de5b72702e07f1e052858ac4c06e3fda4"
 dependencies = [
  "chrono",
  "monty-macros",
@@ -3823,15 +3827,6 @@ version = "0.1.6"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "d05e27ee213611ffe7d6348b942e8f942b37114c00cc03cec254295a4a17852e"
 
-[[package]]
-name = "openssl-src"
-version = "300.6.1+3.6.3"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "46eb8fb9fb3b61ce1c0f8a026c4c1a0714d3a9e138e7fbde78753ce2babc3846"
-dependencies = [
- "cc",
-]
-
 [[package]]
 name = "openssl-sys"
 version = "0.9.117"
@@ -3840,7 +3835,6 @@ checksum = "b47e7e6bb2c38cd930d25a23b40fa52e068c10e85f3e03a7f5ba5aaca5713695"
 dependencies = [
  "cc",
  "libc",
- "openssl-src",
  "pkg-config",
  "vcpkg",
 ]
-- 
2.56.0

