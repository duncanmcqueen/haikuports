From 8af654c11247d2005d3f274ae69ebbcc5bd806d7 Mon Sep 17 00:00:00 2001
From: Gerasim Troeglazov <3dEyes@gmail.com>
Date: Mon, 12 Oct 2026 22:32:54 -0500
Subject: gbuild: keep dep response file instead of deleting it

Deleting a just-written file whose dirty pages were not flushed yet
can leave stale cache block entries on the Haiku bfs volume. Later
files allocated over those blocks fail page-in during large writes,
which surfaces as short writes/EFAULT and makes ld report a bogus
'No space left on device'. The dep response file is consumed once by
concat-deps; leaving it in the temporary directory is harmless.
---
 solenv/gbuild/LinkTarget.mk | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/solenv/gbuild/LinkTarget.mk b/solenv/gbuild/LinkTarget.mk
index 3550b85..8a7f4ee 100644
--- a/solenv/gbuild/LinkTarget.mk
+++ b/solenv/gbuild/LinkTarget.mk
@@ -824,8 +824,7 @@ $(call gb_Helper_abbreviate_dirs,\
 		$(foreach object,$(GENNASMOBJECTS),$(call gb_GenNasmObject_get_dep_target,$(object))) \
 		$(foreach object,$(GENCXXCLROBJECTS),$(call gb_GenCxxClrObject_get_dep_target,$(object))) \
 		) && \
-	SYSTEM_BOOST="$(SYSTEM_BOOST)" $(call gb_Executable_get_command,concat-deps) $${RESPONSEFILE} > $(1)) && \
-	rm -f $${RESPONSEFILE}
+	SYSTEM_BOOST="$(SYSTEM_BOOST)" $(call gb_Executable_get_command,concat-deps) $${RESPONSEFILE} > $(1))
 	$(call gb_Trace_EndRange,LNK:$(2),DEP)
 
 endef
-- 
2.56.0

