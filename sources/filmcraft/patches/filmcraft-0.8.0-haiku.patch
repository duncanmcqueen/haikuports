diff --git a/apps/filmcraft-haiku/src/audio.rs b/apps/filmcraft-haiku/src/audio.rs
new file mode 100644
index 0000000..2cf639c
--- /dev/null
+++ b/apps/filmcraft-haiku/src/audio.rs
@@ -0,0 +1,139 @@
+use filmcraft_ui_egui::{AudioDevices, AudioOut};
+use sdl2::audio::{AudioCallback, AudioDevice, AudioSpecDesired};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+type Fill = Box<dyn FnMut(&mut [f32], usize) + Send>;
+
+struct Callback {
+    fill: Fill,
+    channels: usize,
+    frames: Arc<AtomicU64>,
+    failed: Arc<AtomicBool>,
+}
+
+impl AudioCallback for Callback {
+    type Channel = f32;
+    fn callback(&mut self, output: &mut [f32]) {
+        if self.failed.load(Ordering::Relaxed) {
+            output.fill(0.0);
+            return;
+        }
+        if std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (self.fill)(output, self.channels))).is_err() {
+            output.fill(0.0);
+            self.failed.store(true, Ordering::Relaxed);
+            return;
+        }
+        self.frames.fetch_add((output.len() / self.channels.max(1)) as u64, Ordering::Relaxed);
+    }
+}
+
+pub struct SdlOut {
+    _context: sdl2::Sdl,
+    audio: sdl2::AudioSubsystem,
+    device: Option<AudioDevice<Callback>>,
+    frames: Arc<AtomicU64>,
+    failed: Arc<AtomicBool>,
+    rate: u32,
+    channels: usize,
+    device_name: Option<String>,
+    buffer_size: u16,
+}
+
+impl SdlOut {
+    pub fn new() -> Result<Self, String> {
+        let context = sdl2::init()?;
+        let audio = context.audio()?;
+        Ok(Self {
+            _context: context,
+            audio,
+            device: None,
+            frames: Arc::new(AtomicU64::new(0)),
+            failed: Arc::new(AtomicBool::new(false)),
+            rate: 48_000,
+            channels: 2,
+            device_name: None,
+            buffer_size: 1024,
+        })
+    }
+}
+
+impl AudioOut for SdlOut {
+    fn start(&mut self, fill: Fill) -> Result<u32, String> {
+        self.stop();
+        self.frames.store(0, Ordering::Relaxed);
+        self.failed.store(false, Ordering::Relaxed);
+        let frames = self.frames.clone();
+        let failed = self.failed.clone();
+        let desired = AudioSpecDesired { freq: Some(self.rate as i32), channels: Some(2), samples: Some(self.buffer_size) };
+        let device = self.audio.open_playback(self.device_name.as_deref(), &desired, move |spec| Callback {
+            fill,
+            channels: usize::from(spec.channels),
+            frames,
+            failed,
+        })?;
+        self.rate = u32::try_from(device.spec().freq).map_err(|_| "invalid audio device sample rate")?;
+        if self.rate == 0 || device.spec().channels == 0 {
+            return Err("invalid audio device format".into());
+        }
+        self.channels = usize::from(device.spec().channels);
+        device.resume();
+        self.device = Some(device);
+        Ok(self.rate)
+    }
+    fn stop(&mut self) {
+        if let Some(device) = self.device.take() {
+            device.pause();
+        }
+    }
+    fn sample_rate(&self) -> u32 {
+        self.rate
+    }
+    fn channels(&self) -> usize {
+        self.channels
+    }
+    fn played_frames(&self) -> Option<u64> {
+        if self.device.is_some() && !self.failed.load(Ordering::Relaxed) { Some(self.frames.load(Ordering::Relaxed)) } else { None }
+    }
+    fn devices(&self) -> AudioDevices {
+        let outputs = (0..self.audio.num_audio_playback_devices().unwrap_or(0)).filter_map(|index| self.audio.audio_playback_device_name(index).ok()).collect();
+        AudioDevices { hosts: vec![self.audio.current_audio_driver().into()], outputs, output_channels: self.channels as u16, ..Default::default() }
+    }
+    fn configure(&mut self, settings: &filmcraft_engine::settings::AudioHardwarePrefs, document_rate: Option<u32>) {
+        let rate = if settings.force_document_rate { document_rate.unwrap_or(settings.sample_rate) } else { settings.sample_rate };
+        self.rate = rate.clamp(8_000, 192_000);
+        self.buffer_size = settings.buffer_size.clamp(128, 8192) as u16;
+        self.device_name = (!settings.default_output.is_empty()).then(|| settings.default_output.clone());
+    }
+    fn note(&self) -> Option<String> {
+        self.failed.load(Ordering::Relaxed).then(|| "Audio callback failed; output stopped".into())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn failed_mix_is_silenced_without_unwinding() {
+        let failed = Arc::new(AtomicBool::new(false));
+        let frames = Arc::new(AtomicU64::new(0));
+        let mut callback = Callback {
+            fill: Box::new(|output, _| {
+                output.fill(1.0);
+                panic!("mixer failed");
+            }),
+            channels: 2,
+            frames: frames.clone(),
+            failed: failed.clone(),
+        };
+        let mut output = [0.5; 16];
+        callback.callback(&mut output);
+        assert!(failed.load(Ordering::Relaxed));
+        assert_eq!(output, [0.0; 16]);
+        assert_eq!(frames.load(Ordering::Relaxed), 0);
+        output.fill(0.5);
+        callback.callback(&mut output);
+        assert_eq!(output, [0.0; 16]);
+    }
+}
diff --git a/apps/filmcraft-haiku/src/main.rs b/apps/filmcraft-haiku/src/main.rs
new file mode 100644
index 0000000..0c4fc70
--- /dev/null
+++ b/apps/filmcraft-haiku/src/main.rs
@@ -0,0 +1,204 @@
+#![forbid(unsafe_code)]
+
+mod audio;
+#[path = "../../filmcraft/src/control_server.rs"]
+mod control_server;
+
+use egui_software_backend::{App, SoftwareBackend, SoftwareBackendAppConfiguration, run_app_with_software_backend};
+use filmcraft_engine::Session;
+use filmcraft_engine::autosave::{AutosaveConfig, default_data_dir};
+use filmcraft_ui_egui::FilmcraftApp;
+use filmcraft_ui_egui::native_dialogs::FileDialog;
+use serde_json::json;
+use std::sync::mpsc::{Receiver, channel};
+
+struct Editor {
+    app: FilmcraftApp,
+    ctx: egui::Context,
+    closed: bool,
+}
+
+impl Editor {
+    fn finish(&mut self) {
+        if !self.closed {
+            self.app.stop();
+            self.app.shutdown();
+            self.closed = true;
+        }
+    }
+}
+
+impl Editor {
+    fn draw(&mut self, ui: &mut egui::Ui) {
+        self.app.update_logic(ui.ctx());
+        self.app.show_ui(ui);
+        let closing = ui.ctx().viewport(|viewport| {
+            viewport.commands.iter().fold(false, |closing, command| match command {
+                egui::ViewportCommand::Close => true,
+                egui::ViewportCommand::CancelClose => false,
+                _ => closing,
+            })
+        });
+        if closing {
+            if filmcraft_ui_egui::panels::clip_dialogs::intercept_quit(&mut self.app) {
+                ui.ctx().send_viewport_cmd(egui::ViewportCommand::CancelClose);
+            } else {
+                self.finish();
+            }
+        }
+    }
+}
+
+impl App for Editor {
+    fn raw_input_hook(&mut self, input: &mut egui::RawInput) {
+        self.app.handle_raw_input(&self.ctx, input);
+    }
+    fn ui(&mut self, ui: &mut egui::Ui, _backend: &mut SoftwareBackend) {
+        self.draw(ui);
+    }
+    fn close_requested(&mut self) -> bool {
+        !filmcraft_ui_egui::panels::clip_dialogs::intercept_quit(&mut self.app)
+    }
+    fn on_exit(&mut self, _ctx: &egui::Context) {
+        self.finish();
+    }
+}
+
+fn native_dialog(request: FileDialog, ctx: egui::Context) -> Receiver<Vec<String>> {
+    let (sender, receiver) = channel();
+    if let Err(error) = std::thread::Builder::new().name("file dialog".into()).spawn(move || {
+        let dialog = rfd::FileDialog::new();
+        let paths = match request {
+            FileDialog::OpenFiles { .. } => dialog.pick_files().unwrap_or_default(),
+            FileDialog::OpenFile { .. } | FileDialog::OpenProject | FileDialog::Relink { .. } => dialog.pick_file().into_iter().collect(),
+            FileDialog::SaveProject { name } | FileDialog::SaveAs { name, .. } => dialog.set_file_name(name).save_file().into_iter().collect(),
+            FileDialog::Folder { at } => {
+                let dialog = at.map_or_else(rfd::FileDialog::new, |path| dialog.set_directory(path));
+                dialog.pick_folder().into_iter().collect()
+            }
+        };
+        let _ = sender.send(paths.into_iter().map(|path| path.to_string_lossy().into_owned()).collect());
+        ctx.request_repaint();
+    }) {
+        eprintln!("file dialog: {error}");
+    }
+    receiver
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut demo = false;
+    let mut files = Vec::new();
+    let mut control_port = None;
+    let mut data_dir = None;
+    let mut args = std::env::args().skip(1);
+    while let Some(arg) = args.next() {
+        match arg.as_str() {
+            "--version" => {
+                println!("filmcraft-haiku {}", env!("CARGO_PKG_VERSION"));
+                return Ok(());
+            }
+            "--help" => {
+                println!("filmcraft-haiku [--demo|--empty] [--control PORT] [--data-dir PATH] [PROJECT.fcproj|MEDIA ...]");
+                return Ok(());
+            }
+            "--demo" => demo = true,
+            "--empty" => demo = false,
+            "--control" => control_port = Some(args.next().ok_or("missing control port")?.parse::<u16>()?),
+            "--data-dir" => data_dir = Some(std::path::PathBuf::from(args.next().ok_or("missing data directory")?)),
+            value if value.starts_with('-') => return Err(format!("unknown option: {value}").into()),
+            _ => files.push(arg),
+        }
+    }
+    let configuration = SoftwareBackendAppConfiguration {
+        #[cfg(target_os = "haiku")]
+        haiku_exit_process_on_close: true,
+        viewport_builder: egui::ViewportBuilder::default()
+            .with_title("FilmCraft — Haiku port")
+            .with_app_id("ai.storyteller.filmcraft.haiku")
+            .with_inner_size([1100.0, 700.0])
+            .with_position([40.0, 60.0])
+            .with_min_inner_size([960.0, 640.0]),
+        ..Default::default()
+    };
+    run_app_with_software_backend(configuration, move |ctx| {
+        let mut session = Session::default();
+        if let Some(dir) = data_dir.clone().or_else(default_data_dir) {
+            filmcraft_ui_egui::crash::install(Some(dir.join("Logs")));
+            if let Err(error) = session.start_autosave(AutosaveConfig::new(dir)) {
+                eprintln!("autosave: {error}");
+            }
+        }
+        let project = files.iter().find(|path| path.to_ascii_lowercase().ends_with(".fcproj"));
+        if let Some(path) = project {
+            if let Err(error) = session.execute("file.open", json!({"path": path})) {
+                eprintln!("open project: {error}");
+            }
+        } else if demo && let Err(error) = session.execute("file.openDemoProject", json!({})) {
+            eprintln!("demo project: {error}");
+        }
+        let media: Vec<_> = files.iter().filter(|path| !path.to_ascii_lowercase().ends_with(".fcproj")).collect();
+        if !media.is_empty()
+            && let Err(error) = session.execute("file.import", json!({"paths": media}))
+        {
+            eprintln!("import: {error}");
+        }
+        let mut app = FilmcraftApp::new(session);
+        app.integrated_titlebar = false;
+        let dialog_ctx = ctx.clone();
+        app.hooks.run_dialog = Some(Box::new(move |request| native_dialog(request, dialog_ctx.clone())));
+        match audio::SdlOut::new() {
+            Ok(output) => app.audio = Some(Box::new(output)),
+            Err(error) => app.status(format!("Audio unavailable: {error}")),
+        }
+        if let Some(port) = control_port {
+            app = app.with_control(control_server::start(port, ctx.clone()));
+        }
+        Editor { app, ctx: ctx.clone(), closed: false }
+    })?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn toolbar_icon_mesh_has_finite_vertices() {
+        let ctx = egui::Context::default();
+        let mut output = ctx.run_ui(egui::RawInput::default(), |ui| {
+            for (icon, x) in [(filmcraft_ui_egui::icons::Icon::Speaker, 1026.0), (filmcraft_ui_egui::icons::Icon::Moon, 874.0)] {
+                filmcraft_ui_egui::icons::paint(
+                    ui.painter(),
+                    egui::Rect::from_min_size(egui::pos2(x, 11.0), egui::vec2(16.0, 16.0)),
+                    icon,
+                    egui::Color32::GRAY,
+                );
+            }
+        });
+        let jobs = ctx.tessellate(std::mem::take(&mut output.shapes), output.pixels_per_point);
+        output.textures_delta.clear();
+        assert!(!jobs.is_empty());
+        for job in jobs {
+            if let egui::epaint::Primitive::Mesh(mesh) = job.primitive {
+                assert!(mesh.vertices.iter().all(|vertex| vertex.pos.is_finite() && vertex.uv.is_finite()));
+            }
+        }
+    }
+
+    #[test]
+    fn menu_close_preserves_unsaved_project() {
+        let ctx = egui::Context::default();
+        let mut session = Session::default();
+        session.execute("file.newSequence", json!({"name": "Unsaved", "width": 320, "height": 180, "fps": 24})).unwrap();
+        assert!(session.is_dirty());
+        let mut editor = Editor { app: FilmcraftApp::new(session), ctx: ctx.clone(), closed: false };
+        let mut output = ctx.run_ui(egui::RawInput::default(), |ui| {
+            ui.ctx().send_viewport_cmd(egui::ViewportCommand::Close);
+            editor.draw(ui);
+        });
+        output.textures_delta.clear();
+        assert!(!editor.closed);
+        assert_eq!(editor.app.ui.clip_dialog.as_ref().map(|dialog| dialog.command.as_str()), Some("app.quit"));
+        assert!(output.viewport_output[&egui::ViewportId::ROOT].commands.iter().any(|command| matches!(command, egui::ViewportCommand::CancelClose)));
+    }
+}
