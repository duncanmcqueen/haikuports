From 3382be82c3918724bbe90e8055f12a16e000efa2 Mon Sep 17 00:00:00 2001
From: Gerasim Troeglazov <3dEyes@gmail.com>
Date: Tue, 27 Aug 2024 13:37:05 +1000
Subject: Use system font

---
 vcl/source/app/settings.cxx | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/vcl/source/app/settings.cxx b/vcl/source/app/settings.cxx
index 2dd64e8..06e59fe 100644
--- a/vcl/source/app/settings.cxx
+++ b/vcl/source/app/settings.cxx
@@ -26,6 +26,12 @@
 #include <win/svsys.h>
 #endif
 
+#ifdef __HAIKU__
+#include <kernel/image.h>
+#include <Application.h>
+#include <Font.h>
+#endif
+
 #include <comphelper/processfactory.hxx>
 #include <o3tl/test_info.hxx>
 #include <rtl/bootstrap.hxx>
@@ -475,10 +481,22 @@ void ImplStyleData::SetStandardStyles()
     vcl::Font aStdFont( FAMILY_SWISS, Size( 0, 8 ) );
     aStdFont.SetCharSet( osl_getThreadTextEncoding() );
     aStdFont.SetWeight( WEIGHT_NORMAL );
+#ifdef __HAIKU__
+	if (be_app) {
+	    font_family plainFontFamily;
+	    font_style plainFontStyle;
+		be_plain_font->GetFamilyAndStyle(&plainFontFamily, &plainFontStyle);
+		aStdFont.SetFamilyName(OStringToOUString(std::string_view(plainFontFamily), osl_getThreadTextEncoding()));
+		aStdFont.SetStyleName(OStringToOUString(std::string_view(plainFontStyle), osl_getThreadTextEncoding()));
+	} else {
+		aStdFont.SetFamilyName("Noto Sans Display");
+	}
+#else
     if (!comphelper::IsFuzzing())
         aStdFont.SetFamilyName(utl::DefaultFontConfiguration::get().getUserInterfaceFont(LanguageTag(u"en"_ustr)));
     else
         aStdFont.SetFamilyName(u"Liberation Sans"_ustr);
+#endif
     maFonts.maAppFont                   = aStdFont;
     maFonts.maHelpFont                  = aStdFont;
     maFonts.maMenuFont                  = aStdFont;
-- 
2.56.0


From e7c4fd54d127046e3b29c6b507947dfc7a1d3673 Mon Sep 17 00:00:00 2001
From: Gerasim Troeglazov <3dEyes@gmail.com>
Date: Tue, 27 Aug 2024 20:57:22 +1000
Subject: Qt::Popup window handling; Don't use Cairo by default

---
 vcl/qt5/QtInstance.cxx | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/vcl/qt5/QtInstance.cxx b/vcl/qt5/QtInstance.cxx
index 8fec94a..a2c0282 100644
--- a/vcl/qt5/QtInstance.cxx
+++ b/vcl/qt5/QtInstance.cxx
@@ -267,7 +267,11 @@ void QtInstance::EmscriptenLightweightRunInMainThread_(std::function<void()> fun
 
 bool QtInstance::useCairo()
 {
+#ifdef __HAIKU__
+    static bool bUseCairo = getenv("SAL_VCL_QT_USE_CAIRO") != nullptr;
+#else
     static bool bUseCairo = getenv("SAL_VCL_QT_USE_QFONT") == nullptr;
+#endif
     return bUseCairo;
 }
 
@@ -643,7 +647,7 @@ Platform QtInstance::GetPlatform() const
         return Platform::Wayland;
     if (sPlatformName == u"xcb")
         return Platform::Xcb;
-    if (sPlatformName == u"wasm")
