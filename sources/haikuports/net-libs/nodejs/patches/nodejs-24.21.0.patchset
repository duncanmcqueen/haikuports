       'ldflags': [
diff --git a/src/node.cc b/src/node.cc
index 838106ac..58dadd98 100644
--- a/src/node.cc
+++ b/src/node.cc
@@ -512,10 +512,20 @@ void ResetSignalHandlers() {
       // library) has set up own signal handler for own purposes
       // (e.g. profiling). If that's the case, we want to keep it intact.
       struct sigaction old;
+#ifdef __HAIKU__
+      // Haiku rejects some numbers below kMaxSignal with EINVAL. Skip them
+      // instead of aborting, and keep resetting the signals it does support.
+      if (sigaction(nr, nullptr, &old) != 0) continue;
+#else
       CHECK_EQ(0, sigaction(nr, nullptr, &old));
+#endif
       if ((old.sa_flags & SA_SIGINFO) || old.sa_handler != SIG_IGN) continue;
     }
+#ifdef __HAIKU__
+    sigaction(nr, &act, nullptr);
+#else
     CHECK_EQ(0, sigaction(nr, &act, nullptr));
+#endif
   }
 #endif  // __POSIX__
 }
diff --git a/src/node_report.cc b/src/node_report.cc
index 04c5d415..4cc806c2 100644
--- a/src/node_report.cc
+++ b/src/node_report.cc
@@ -738,16 +738,16 @@ static void PrintSystemInformation(JSONWriter* writer) {
     {"core_file_size_blocks", RLIMIT_CORE},
     {"data_seg_size_bytes", RLIMIT_DATA},
     {"file_size_blocks", RLIMIT_FSIZE},
-#if !(defined(_AIX) || defined(__sun))
+#if !(defined(_AIX) || defined(__sun) || defined(__HAIKU__))
     {"max_locked_memory_bytes", RLIMIT_MEMLOCK},
 #endif
-#ifndef __sun
+#if !(defined(__sun) || defined(__HAIKU__))
     {"max_memory_size_bytes", RLIMIT_RSS},
 #endif
     {"open_files", RLIMIT_NOFILE},
     {"stack_size_bytes", RLIMIT_STACK},
     {"cpu_time_seconds", RLIMIT_CPU},
-#ifndef __sun
+#if !(defined(__sun) || defined(__HAIKU__))
     {"max_user_processes", RLIMIT_NPROC},
 #endif
 #ifndef __OpenBSD__
diff --git a/src/tcp_wrap.cc b/src/tcp_wrap.cc
index 7ed24661..640ca9dc 100644
--- a/src/tcp_wrap.cc
+++ b/src/tcp_wrap.cc
@@ -45,6 +45,11 @@
 #include <unistd.h>  // dup(), close()
 #endif
 
+// Haiku does not define IPV6_TCLASS; use the standard value (RFC 3542).
+#ifndef IPV6_TCLASS
+#define IPV6_TCLASS 67
+#endif
+
 namespace node {
 
 using v8::Boolean;
diff --git a/tools/utils.py b/tools/utils.py
index f0172b3c..d7cb21a0 100644
--- a/tools/utils.py
+++ b/tools/utils.py
@@ -59,6 +59,8 @@ def GuessOS():
     return 'win32'
   elif id == 'FreeBSD':
     return 'freebsd'
+  elif id == 'Haiku':
+    return 'haiku'
   elif id == 'OpenBSD':
     return 'openbsd'
   elif id == 'SunOS':
