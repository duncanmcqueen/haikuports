index 0000000..4b54013
--- /dev/null
+++ b/apps/filmcraft-haiku/examples/render-header.rs
@@ -0,0 +1,45 @@
+use egui_software_backend::{BufferMutRef, ColorFieldOrder, EguiSoftwareRender};
+use filmcraft_engine::Session;
+use filmcraft_ui_egui::FilmcraftApp;
+use std::io::Write;
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let ctx = egui::Context::default();
+    let mut app = FilmcraftApp::new(Session::default());
+    app.ui.mode = filmcraft_ui_egui::state::Mode::Edit;
+    let mut warmup =
+        ctx.run_ui(egui::RawInput { screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1100.0, 700.0))), ..Default::default() }, |ui| {
+            app.update_logic(ui.ctx());
+            app.show_ui(ui);
+        });
+    let mut output =
+        ctx.run_ui(egui::RawInput { screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1100.0, 700.0))), ..Default::default() }, |ui| {
+            app.update_logic(ui.ctx());
+            app.show_ui(ui);
+        });
+    let mut combined = std::mem::take(&mut warmup.textures_delta);
+    combined.append(std::mem::take(&mut output.textures_delta));
+    output.textures_delta = combined;
+    eprintln!("shapes={} textures={} rect={:?}", output.shapes.len(), output.textures_delta.set.len(), ctx.content_rect());
+    std::fs::write("/tmp/filmcraft-shapes.txt", format!("{:#?}", output.shapes))?;
+    let jobs = ctx.tessellate(output.shapes.clone(), output.pixels_per_point);
+    for job in &jobs {
+        if let egui::epaint::Primitive::Mesh(mesh) = &job.primitive {
+            assert!(mesh.vertices.iter().all(|vertex| vertex.pos.is_finite() && vertex.uv.is_finite()));
+        }
+    }
+    for (name, caching, opt, rects) in
+        [("normal", true, true, true), ("uncached", false, true, true), ("triangles", false, true, false), ("unoptimized", false, false, false)]
+    {
+        let mut renderer = EguiSoftwareRender::new(ColorFieldOrder::Rgba).with_caching(caching).with_allow_raster_opt(opt).with_convert_tris_to_rects(rects);
+        let mut pixels = vec![[0; 4]; 1100 * 700];
+        renderer.render(&mut BufferMutRef::new(&mut pixels, 1100, 700), &jobs, &output.textures_delta, output.pixels_per_point);
+        let mut file = std::fs::File::create(format!("/tmp/filmcraft-{name}.ppm"))?;
+        write!(file, "P6\n1100 700\n255\n")?;
+        for pixel in pixels {
+            file.write_all(&pixel[..3])?;
+        }
+    }
+    output.textures_delta.clear();
+    Ok(())
+}
