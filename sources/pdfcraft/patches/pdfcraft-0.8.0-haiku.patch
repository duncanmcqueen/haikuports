diff --git a/apps/pdfcraft-haiku/src/control_file.rs b/apps/pdfcraft-haiku/src/control_file.rs
new file mode 100644
index 0000000..2676aec
--- /dev/null
+++ b/apps/pdfcraft-haiku/src/control_file.rs
@@ -0,0 +1,41 @@
+pub fn write_control_file(path: &str, port: u16, token: &str) -> std::io::Result<()> {
+    use std::io::{ErrorKind, Write};
+    let json = serde_json::json!({ "port": port, "token": token, "pid": std::process::id() }).to_string();
+    let path = std::path::Path::new(path);
+    let name = path.file_name().ok_or_else(|| std::io::Error::new(ErrorKind::InvalidInput, "not a file name"))?;
+    // Unpredictable suffixes, so the name can't be planted in advance. `RandomState` is keyed from
+    // the operating system's random source.
+    let random = std::hash::RandomState::new();
+    for i in 0..16u32 {
+        let mut staged = std::ffi::OsString::from(".");
+        staged.push(name);
+        staged.push(format!(".{:016x}.tmp", std::hash::BuildHasher::hash_one(&random, i)));
+        let staged = path.with_file_name(staged);
+        let mut opts = std::fs::OpenOptions::new();
+        opts.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            opts.mode(0o600);
+        }
+        let file = match opts.open(&staged) {
+            Ok(f) => f,
+            Err(e) if e.kind() == ErrorKind::AlreadyExists => continue,
+            // Windows refuses `create_new` on a folder with "access denied"; the name is taken all
+            // the same. A folder we can't write to, with nothing at the name, still fails here.
+            Err(e) if e.kind() == ErrorKind::PermissionDenied && staged.symlink_metadata().is_ok() => continue,
+            Err(e) => return Err(e),
+        };
+        // The block closes the file before it is renamed.
+        let written = {
+            let mut file = file;
+            file.write_all(json.as_bytes())
+        };
+        let done = written.and_then(|()| std::fs::rename(&staged, path));
+        if done.is_err() {
+            let _ = std::fs::remove_file(&staged);
+        }
+        return done;
+    }
+    Err(std::io::Error::new(ErrorKind::AlreadyExists, "no free name for the control file's temporary copy"))
+}
diff --git a/apps/pdfcraft-haiku/src/main.rs b/apps/pdfcraft-haiku/src/main.rs
new file mode 100644
index 0000000..9a0fce1
--- /dev/null
+++ b/apps/pdfcraft-haiku/src/main.rs
@@ -0,0 +1,158 @@
+#![forbid(unsafe_code)]
+
+mod control_file;
+
+use egui_software_backend::{App, SoftwareBackend, SoftwareBackendAppConfiguration, run_app_with_software_backend};
+use pdfcraft_ui_egui::{PdfCraftApp, RecoveryStore};
+use std::io::{Read, Write};
+use std::path::PathBuf;
+
+struct Editor {
+    app: PdfCraftApp,
+    ctx: egui::Context,
+    settings: PathBuf,
+    closed: bool,
+}
+
+impl Editor {
+    fn finish(&mut self) {
+        if self.closed {
+            return;
+        }
+        self.app.shutdown_recovery();
+        if let Err(error) = save_settings(&self.settings, &self.app.persist()) {
+            eprintln!("save settings: {error}");
+        }
+        self.closed = true;
+    }
+}
+
+impl App for Editor {
+    fn raw_input_hook(&mut self, input: &mut egui::RawInput) {
+        self.app.handle_raw_input(&self.ctx, input);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, _backend: &mut SoftwareBackend) {
+        self.app.update_logic(ui.ctx());
+        self.app.show_ui(ui);
+        let closing = ui.ctx().viewport(|viewport| {
+            viewport.commands.iter().fold(false, |closing, command| match command {
+                egui::ViewportCommand::Close => true,
+                egui::ViewportCommand::CancelClose => false,
+                _ => closing,
+            })
+        });
+        if closing {
+            if self.app.request_quit(ui.ctx()) {
+                self.finish();
+            } else {
+                ui.ctx().send_viewport_cmd(egui::ViewportCommand::CancelClose);
+            }
+        }
+    }
+
+    fn close_requested(&mut self) -> bool {
+        self.app.request_quit(&self.ctx)
+    }
+
+    fn on_exit(&mut self, _ctx: &egui::Context) {
+        self.finish();
+    }
+}
+
+fn save_settings(path: &std::path::Path, json: &str) -> std::io::Result<()> {
+    let staged = path.with_file_name(format!(".settings-{}.tmp", std::process::id()));
+    let mut options = std::fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&staged)?;
+    let result = file.write_all(json.as_bytes()).and_then(|()| file.sync_all());
+    drop(file);
+    let result = result.and_then(|()| std::fs::rename(&staged, path));
+    if result.is_err() {
+        let _ = std::fs::remove_file(&staged);
+    }
+    result
+}
+
+fn read_settings(path: &std::path::Path) -> std::io::Result<String> {
+    const LIMIT: u64 = 8 * 1024 * 1024;
+    let file = std::fs::File::open(path)?;
+    let mut json = String::new();
+    file.take(LIMIT + 1).read_to_string(&mut json)?;
+    if json.len() as u64 > LIMIT {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "settings file exceeds 8 MiB"));
+    }
+    Ok(json)
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut files = Vec::new();
+    let mut control_file = None;
+    let mut data_dir = None;
+    let mut args = std::env::args().skip(1);
+    while let Some(arg) = args.next() {
+        match arg.as_str() {
+            "--version" => {
+                println!("pdfcraft-haiku {}", env!("CARGO_PKG_VERSION"));
+                return Ok(());
+            }
+            "--help" => {
+                println!("pdfcraft-haiku [--control FILE] [--data-dir PATH] [PDF ...]");
+                return Ok(());
+            }
+            "--control" => control_file = Some(args.next().ok_or("missing control file")?),
+            "--data-dir" => data_dir = Some(PathBuf::from(args.next().ok_or("missing data directory")?)),
+            value if value.starts_with('-') => return Err(format!("unknown option: {value}").into()),
+            _ => files.push(arg),
+        }
+    }
+    let data_dir = data_dir.unwrap_or_else(|| {
+        let home = std::env::var_os("HOME").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
+        home.join(if cfg!(target_os = "haiku") { "config/settings/Pdfcraft" } else { ".config/Pdfcraft" })
+    });
+    std::fs::create_dir_all(&data_dir)?;
+    let settings = data_dir.join("settings.json");
+    let saved = match read_settings(&settings) {
+        Ok(value) => Some(value),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,
+        Err(error) => return Err(error.into()),
+    };
+    let configuration = SoftwareBackendAppConfiguration {
+        #[cfg(target_os = "haiku")]
+        haiku_exit_process_on_close: true,
+        viewport_builder: egui::ViewportBuilder::default()
+            .with_title("PdfCraft — Haiku port")
+            .with_app_id("ai.storyteller.pdfcraft.haiku")
+            .with_inner_size([1100.0, 700.0])
+            .with_min_inner_size([820.0, 520.0]),
+        ..Default::default()
+    };
+    run_app_with_software_backend(configuration, move |ctx| {
+        let mut app = PdfCraftApp::new();
+        if let Some(saved) = &saved {
+            app.restore(saved);
+        }
+        app.integrated_titlebar = false;
+        app.window_controls = None;
+        app.system_title_bar = true;
+        app.enable_recovery(RecoveryStore::new(data_dir.join("Recovery")));
+        if let Some(path) = &control_file {
+            let client = app.attach_control(&ctx);
+            match pdfcraft_ui_egui::control::serve(client).and_then(|endpoint| control_file::write_control_file(path, endpoint.port, &endpoint.token))
+            {
+                Ok(()) => {}
+                Err(error) => app.notify_error(format!("control channel: {error}")),
+            }
+        }
+        for file in &files {
+            app.open_path(file);
+        }
+        Editor { app, ctx, settings: settings.clone(), closed: false }
+    })?;
+    Ok(())
+}
