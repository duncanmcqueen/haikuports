+static int
+haiku_open_render_node(void)
+{
+   static const char kPrefix[] = "intel_render_9x_";
+   DIR *dir = opendir("/dev/graphics");
+   if (dir == NULL)
+      return -1;
+
+   int fd = -1;
+   struct dirent *entry;
+   while ((entry = readdir(dir)) != NULL) {
+      if (strncmp(entry->d_name, kPrefix, sizeof(kPrefix) - 1) != 0)
+         continue;
+      char path[300];
+      snprintf(path, sizeof(path), "/dev/graphics/%s", entry->d_name);
+      fd = open(path, O_RDWR);
+      if (fd >= 0)
+         break;
+   }
+   closedir(dir);
+   return fd;
+}
