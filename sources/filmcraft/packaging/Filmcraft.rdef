resource app_signature "application/x-vnd.storytold-filmcraft-haiku";
resource app_flags B_MULTIPLE_LAUNCH;
resource app_version {
    major = 0,
    middle = 8,
    minor = 0,
    variety = B_APPV_ALPHA,
    internal = 4,
    short_info = "Filmcraft 0.8.0 (Haiku experimental)",
    long_info = "Video editor with an experimental Haiku software frontend"
};
