+++ b/vcl/source/app/IconThemeSelector.cxx
@@ -69,7 +69,7 @@ IconThemeSelector::IconThemeSelector()
     else
         return "colibre_dark";
 #elif defined(__HAIKU__)
-    (void)desktopEnvironment;
+    (void)eDesktop;
     return "elementary";
 #else
     OUString r;
-- 
2.56.0

From 5ee50fd97bf9ddc3a9b7813aa6dadc65ae8fd29b Mon Sep 17 00:00:00 2001
From: Gerasim Troeglazov <3dEyes@gmail.com>
Date: Mon, 12 Oct 2026 23:12:25 -0500
Subject: [PATCH] Fix misplaced Haiku branch in
 SalGenericInstance::getOSVersion

The Haiku #elif block was appended after the end of the function
instead of inside the platform #if chain, leaving it outside the
function body where it does not compile. Move it before the chain's
closing #endif.
---
 vcl/unx/generic/app/geninst.cxx | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/vcl/unx/generic/app/geninst.cxx b/vcl/unx/generic/app/geninst.cxx
index 62ffe27..5bc837c 100644
--- a/vcl/unx/generic/app/geninst.cxx
+++ b/vcl/unx/generic/app/geninst.cxx
@@ -92,11 +92,6 @@ OUString SalGenericInstance::getOSVersion()
                  + OUString::number(__EMSCRIPTEN_minor__) + u"."_ustr
                  + OUString::number(__EMSCRIPTEN_tiny__);
 #endif
-#endif
-    return aKernelVer;
-}
-
-/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
 #elif defined(__HAIKU__)
     struct utsname stName;
     if ( uname( &stName ) != 0 )
@@ -107,3 +102,8 @@ OUString SalGenericInstance::getOSVersion()
 		return OUString::createFromAscii( stName.sysname ) + " " + OUString::createFromAscii(haikuRevision);
 
 	return OUString::createFromAscii( stName.sysname );
+#endif
+    return aKernelVer;
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
-- 
2.56.0

